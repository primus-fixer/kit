{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starter",
  "mainBinaryName": "starter",
  "version": "0.1.0",
  "identifier": "io.github.primusfixer.starter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Заготовка",
        "width": 1100,
        "height": 780,
        "minWidth": 380,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Заготовка — приложение на общем модуле kit",
    "longDescription": "Заготовка нового приложения на общем модуле kit: вход по PIN-коду, зашифрованная база, обмен по Wi-Fi и через облако.",
    "category": "Utility",
    "copyright": "primus-fixer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
